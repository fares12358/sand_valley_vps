# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name in the path.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/sandvalley?retryWrites=true&w=majority&appName=<app>
# Optional: database name when MONGO_URI has none (Atlas would use "test"). Keep it unset if the URI names the database.
# MONGO_DB=sandvalley
JWT_SECRET=change-me
EMAIL_USER=
EMAIL_PASS=
PORT=5000

# Public address of this API, used to build absolute image URLs and e-mail links (no trailing slash)
PUBLIC_BASE_URL=http://localhost:5000

# Where uploaded images are stored (default: backend/uploads). Use an absolute path on the VPS and back it up.
# UPLOAD_DIR=/var/lib/sandvalley/uploads

# Seconds-level safety net for the in-memory read cache (ms). 0 disables it. Keep small if you run several Node processes.
# READ_CACHE_TTL_MS=300000

# First-time admin, only read by scripts/seed.mjs
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Admin
