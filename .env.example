# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# --- MongoDB (runs in its own container, data kept in the "mongo-data" volume) ---
MONGO_ROOT_USER=sandvalley
# Use letters and digits only (it goes into a connection string), e.g.  openssl rand -hex 24
MONGO_ROOT_PASSWORD=
MONGO_DB=sandvalley

# --- API ---
# Long random string, e.g.  openssl rand -hex 48
JWT_SECRET=
# Gmail address + app password: used for verification e-mails and forgot-password codes
EMAIL_USER=
EMAIL_PASS=
# The address people open in the browser (also used for image URLs and e-mail links). No trailing slash.
PUBLIC_BASE_URL=http://localhost

# --- Web ---
# Host port for the dashboard + API (80 on a real server)
WEB_PORT=80

# --- First-time admin (only read by the seed script) ---
ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed once
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
