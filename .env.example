# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# --- Database: MongoDB Atlas ---
# Atlas > Connect > Drivers. Put the database name in the path (…mongodb.net/sandvalley?…) and allow this
# server's IP under Network Access. Use a database user with read/write on that database only.
MONGO_URI=
# Optional: database name, used only when MONGO_URI has none (Atlas would otherwise use "test")
MONGO_DB=

# --- API ---
# Long random string, e.g.  openssl rand -hex 48
JWT_SECRET=
# Gmail address + app password: used for verification e-mails and forgot-password codes
EMAIL_USER=
EMAIL_PASS=
# The address people open in the browser (also used for image URLs and e-mail links). No trailing slash.
PUBLIC_BASE_URL=http://localhost

# --- Web ---
# Host port for the dashboard + API (80 on a real server)
WEB_PORT=80

# --- First-time admin (only read by the seed script) ---
ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed once
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
